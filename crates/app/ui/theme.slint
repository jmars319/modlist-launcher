import { Button, Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> text: Palette.foreground;
    out property <color> secondary-text: Palette.foreground.transparentize(40%);
    out property <color> surface: dark ? #2c2c2e : #ffffff;
    out property <color> surface-border: dark ? #ffffff17 : #0000001a;
    out property <color> window-background: dark ? #1c1c1e : #f2f2f7;
    out property <color> separator: dark ? #ffffff1f : #0000001a;
    out property <color> ready: dark ? #32d74b : #248a3d;
    out property <color> running: dark ? #0a84ff : #0066cc;
    out property <color> warning: dark ? #ffd60a : #a05a00;
    out property <color> danger: dark ? #ff453a : #c4281c;
    out property <color> scrim: dark ? #000000a6 : #00000059;
    out property <length> radius: 14px;
}

export struct Message {
    text: string,
    error: bool,
}

/// A modal panel over a dimmed window, like a macOS sheet. Escape closes it.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> panel-width: 540px;
    callback close();

    background: Theme.scrim;
    forward-focus: scope;

    TouchArea { }

    panel := Rectangle {
        width: min(root.width - 32px, root.panel-width);
        height: min(root.height - 48px, content.preferred-height);
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        border-radius: 16px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.surface-border;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #00000059;
        clip: true;
        accessible-role: groupbox;
        accessible-label: root.title;

        scope := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                reject
            }
            content := VerticalLayout {
                padding: 24px;
                padding-top: 22px;
                spacing: 14px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.title;
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        font-size: 13px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                }
                @children
            }
        }
    }
}

export component FieldLabel inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.secondary-text;
    accessible-role: none;
}

export component Messages inherits VerticalLayout {
    in property <[Message]> items;
    spacing: 4px;
    for m in items: HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 6px;
            height: 6px;
            y: 6px;
            border-radius: 3px;
            background: m.error ? Theme.danger : Theme.warning;
        }
        Text {
            text: m.text;
            font-size: 12px;
            color: m.error ? Theme.danger : Theme.secondary-text;
            wrap: word-wrap;
            accessible-label: (m.error ? "Error: " : "Note: ") + m.text;
        }
    }
}

export component ButtonRow inherits HorizontalLayout {
    spacing: 10px;
    padding-top: 6px;
    alignment: end;
}

/// A full-width row in an action sheet.
export component ActionItem inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> destructive;
    in property <bool> enabled: true;
    callback clicked();

    height: max(40px, row.preferred-height + 16px);
    border-radius: 10px;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.separator
        : (touch.has-hover || focus.has-focus) ? Palette.foreground.transparentize(94%) : transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    Rectangle {
        visible: focus.has-focus;
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Palette.accent-background;
    }
    row := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.text;
            font-size: 14px;
            color: !root.enabled ? Theme.secondary-text : root.destructive ? Theme.danger : Theme.text;
            accessible-role: none;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: 12px;
            color: Theme.secondary-text;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}
